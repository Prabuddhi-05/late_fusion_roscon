{
  "name": "ROSCon CPU cached detections",
  "dockerComposeFile": ["../../compose.yaml"],
  "service": "cpu",
  "runServices": ["cpu"],
  "workspaceFolder": "/workspace",
  "remoteUser": "roscon",
  "updateRemoteUserUID": true,
  "shutdownAction": "stopCompose",
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "ROSCon RViz2 desktop",
      "onAutoForward": "openBrowser"
    }
  }
}
